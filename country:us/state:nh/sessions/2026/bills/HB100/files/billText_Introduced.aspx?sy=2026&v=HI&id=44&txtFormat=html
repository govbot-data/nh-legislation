			<tr style="height:14.9pt;">
				<td class="cs177C9614" width="166"><p class="cs95E872D0"><span class="cs5925EB86">Local Expenditures</span></p></td><td class="cs29CF3B23" colspan="4" width="483"><p class="cs2E86D3A6"><span class="csDD5E5F52">Indeterminable</span></p></td></tr>
