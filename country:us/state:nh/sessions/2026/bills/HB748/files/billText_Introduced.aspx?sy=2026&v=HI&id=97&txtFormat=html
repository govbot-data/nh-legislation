				<td class="csA94B3E59" width="303"><p class="cs95E872D0"><span class="csDD5E5F52">English Language Learner Aid</span></p></td><td class="cs3D67E44E" width="120"><p class="cs1157FFE2"><span class="csDD5E5F52">$832.32 </span></p></td><td class="cs3D67E44E" width="120"><p class="cs1157FFE2"><span class="csDD5E5F52">$1,664.64 </span></p></td></tr>
